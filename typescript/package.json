{
  "name": "@meshtastic/takpacket-sdk",
  "version": "0.7.0",
  "description": "CoT XML to TAKPacketV2 conversion and zstd dictionary compression for Meshtastic",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc"
  },
  "dependencies": {
    "fast-xml-parser": "^5.5.10",
