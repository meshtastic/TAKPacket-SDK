  },
  "files": [
    "dist",
    "resources"
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/meshtastic/TAKPacket-SDK"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typedoc": "^0.28.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
