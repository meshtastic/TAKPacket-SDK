<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Version>0.8.1</Version>
    <PackageId>Meshtastic.TAK</PackageId>
    <Authors>Meshtastic</Authors>
    <Description>CoT XML to TAKPacketV2 conversion and zstd dictionary compression for Meshtastic</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/meshtastic/TAKPacket-SDK</PackageProjectUrl>
    <RepositoryUrl>https://github.com/meshtastic/TAKPacket-SDK</RepositoryUrl>
    <PackageTags>tak;meshtastic;cot;protobuf;compression</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ship the XML doc file in the package so consumers get IntelliSense from the
         /// doc comments, and feed DocFX for the hosted API site. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 = missing XML doc on a public member. The generated Atak.cs is
         undocumented by design, so don't let it warn (or fail) the build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Rendered as the package landing page on NuGet.org. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Resources\dict_non_aircraft.zstd" Pack="true" PackagePath="content" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Resources\dict_aircraft.zstd" Pack="true" PackagePath="content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Package landing page; PackagePath="\" puts it at the nupkg root to match
         <PackageReadmeFile>. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
